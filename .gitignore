# OpenCode keeps API keys here, NOT in opencode.json. It should never end up
# in this repo, but if one is ever copied in by accident, do not commit it.
auth.json
**/auth.json

# Backups made when a step moves an existing config aside.
*.backup-*

# Generated by bin/opencode-config from opencode.json.tmpl (only the installed
# ollama models). The template is the source of truth; this is per-machine.
config/opencode/opencode.json

# This repo's AI setup lives in OpenCode (config/opencode), not Claude Code.
.claude/

.DS_Store
