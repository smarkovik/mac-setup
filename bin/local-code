#!/bin/bash
# local-code - control panel for the local coding models used by OpenCode.
#
# Three tiers of Qwen3-Coder-30B-A3B, one Hub repo at different quants, built
# into a short ollama tag (`ollama create` from a downloaded GGUF, with the
# context window baked in) so `ollama list` and OpenCode's model picker show
# `qwen3-coder:small|mid|big` instead of the long hf.co checkpoint name:
#
#   small  IQ4_XS  ~16GB  fastest, lowest RAM headroom needed
#   mid    Q5_K_M  ~22GB  balanced
#   big    Q6_K    ~25GB  quality ceiling for a 48GB machine (see below)
#
# Not `ollama pull hf.co/...`: HuggingFace serves GGUF blobs from a separate CDN
# host (xet) via a redirect ollama refuses ("blocked redirect to a different
# host"). curl follows it, so each tier is downloaded then built locally.
#
# Q8 is deliberately not offered here: on a 48GB Mac it leaves almost no
# headroom for KV cache or anything else running, for a quality jump that is
# the flattest part of the curve on a sparse MoE like this one.
#
# Usage:
#   local-code list                 show the tiers, what's pulled, sizes
#   local-code pull   small|mid|big|all
#   local-code run    small|mid|big  pull if needed, start ollama, launch OpenCode
#   local-code wipe   small|mid|big|all
#   local-code sync                 rebuild opencode.json to match what's installed
set -euo pipefail

# Resolve our own repo bin dir (even when invoked via the ~/bin symlink) so we
# can call the sibling opencode-config generator after changing what's installed.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
    link="$(readlink "$SELF")"
    case "$link" in /*) SELF="$link" ;; *) SELF="$(dirname "$SELF")/$link" ;; esac
done
BINDIR="$(cd "$(dirname "$SELF")" && pwd)"

HF_REPO="unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF"
MODEL="Qwen3-Coder-30B-A3B-Instruct"   # GGUF filename prefix inside that repo

# Context window baked into each tier at `ollama create` time. ollama otherwise
# defaults to ~4k, too small for coding; the old :30b-32k tags relied on 32k.
# Override with LOCAL_CODE_NUM_CTX if you have the RAM for more.
NUM_CTX="${LOCAL_CODE_NUM_CTX:-32768}"

tier_quant() {
    case "$1" in
        small) echo "IQ4_XS" ;;
        mid)   echo "Q5_K_M" ;;
        big)   echo "Q6_K" ;;
        *)     return 1 ;;
    esac
}

# Approximate .gguf size on the Hub, for the disk-space check before pulling.
# Not authoritative - curl shows the real size as it downloads.
tier_size_gb() {
    case "$1" in
        small) echo 17 ;;
        mid)   echo 22 ;;
        big)   echo 26 ;;
    esac
}

TAG="qwen3-coder"
ALL_TIERS="small mid big"

log()  { printf '  %s\n' "$1"; }
warn() { printf '  \033[0;33m%s\033[0m\n' "$1" >&2; }
err()  { printf '  \033[1;31m%s\033[0m\n' "$1" >&2; }

need_ollama() {
    if ! command -v ollama >/dev/null 2>&1; then
        err "ollama not found on PATH - install the ollama-app cask or 'brew install ollama'"
        exit 1
    fi
}

local_name() { printf '%s:%s\n' "$TAG" "$1"; }
gguf_url()   { printf 'https://huggingface.co/%s/resolve/main/%s-%s.gguf?download=true\n' "$HF_REPO" "$MODEL" "$(tier_quant "$1")"; }

is_pulled() {
    ollama list 2>/dev/null | awk '{print $1}' | grep -qxF "$(local_name "$1")"
}

free_gb() {
    # macOS `df -g` prints whole gigabytes of free space on the volume `ollama`
    # actually stores models on (~/.ollama by default).
    #
    # `|| true`: under `set -e`+pipefail a df failure (unusual filesystem,
    # permissions) would otherwise kill the whole script here - the space
    # check is a nice-to-have, never worth aborting a pull over.
    df -g "$HOME" 2>/dev/null | awk 'NR==2 {print $4}' || true
}

cmd_list() {
    need_ollama
    printf '  %-6s %-8s %-6s %s\n' "TIER" "QUANT" "~SIZE" "STATUS"
    for t in $ALL_TIERS; do
        status="not pulled"
        is_pulled "$t" && status="pulled"
        printf '  %-6s %-8s %-4sGB %s\n' "$t" "$(tier_quant "$t")" "$(tier_size_gb "$t")" "$status"
    done
    free="$(free_gb)"
    [ -n "$free" ] && printf '\n  %s GB free on %s\n' "$free" "$HOME"
}

cmd_pull() {
    need_ollama
    local tier="$1"
    if is_pulled "$tier"; then
        log "$(local_name "$tier") already pulled"
        return 0
    fi

    # The GGUF is downloaded to a temp file, then `ollama create` copies it into
    # ollama's store - both exist at once, so check for ~2x the size.
    local need free
    need="$(tier_size_gb "$tier")"
    free="$(free_gb)"
    if [ -n "$free" ] && [ "$free" -lt "$((need * 2))" ]; then
        err "only ${free}GB free; download + create needs ~$((need * 2))GB transiently - 'local-code wipe' one you don't need first"
        exit 1
    fi

    local url tmp modelfile
    url="$(gguf_url "$tier")"
    tmp="${TMPDIR:-/tmp}/local-code-${MODEL}-$(tier_quant "$tier").gguf"

    # curl follows HF's cross-host CDN redirect that `ollama pull` refuses.
    # `-C -` resumes a partial file, so an interrupted pull picks up where it left
    # off; the temp is removed only on a successful create.
    log "downloading $(tier_quant "$tier") gguf (~${need}GB, resumable)"
    curl -fL -C - -o "$tmp" "$url"

    modelfile="$(mktemp)"
    printf 'FROM %s\nPARAMETER num_ctx %s\n' "$tmp" "$NUM_CTX" > "$modelfile"

    log "creating $(local_name "$tier") (num_ctx=$NUM_CTX)"
    ollama create "$(local_name "$tier")" -f "$modelfile"

    rm -f "$modelfile" "$tmp"
}

cmd_wipe() {
    need_ollama
    local tier="$1"
    if ! is_pulled "$tier"; then
        log "$(local_name "$tier") not pulled - nothing to wipe"
        return 0
    fi
    log "removing $(local_name "$tier")"
    ollama rm "$(local_name "$tier")"
}

cmd_run() {
    need_ollama
    local tier="$1"
    is_pulled "$tier" || cmd_pull "$tier"

    if ! pgrep -x ollama >/dev/null 2>&1; then
        log "starting ollama serve"
        ollama serve >/dev/null 2>&1 &
        disown
        sleep 1
    fi

    if [ -d "/Applications/OpenCode.app" ]; then
        log "opening OpenCode"
        open -a "OpenCode"
    else
        warn "OpenCode.app not found in /Applications - open it yourself"
    fi

    printf '\n  select provider "ollama", model "%s" in OpenCode\n' "$(local_name "$tier")"
}

for_each_tier() {
    local action="$1"
    for t in $ALL_TIERS; do "$action" "$t"; done
}

# Regenerate opencode.json so its ollama model list matches what's installed.
sync_config() {
    [ -x "$BINDIR/opencode-config" ] && "$BINDIR/opencode-config" || true
}

usage() {
    cat <<'EOF'
local-code - run local coding models in OpenCode

Three quant tiers of one model (Qwen3-Coder-30B-A3B) - same weights, trading
size and RAM for a little quality:

    small   IQ4_XS   ~16GB   fastest, least memory
    mid     Q5_K_M   ~22GB   balanced
    big     Q6_K     ~25GB   best quality that fits a 48GB Mac

Commands:
    local-code list                       tiers, which are downloaded, disk free
    local-code pull   small|mid|big|all   download a tier (or all) and build it
    local-code run    small|mid|big       pull if needed, start ollama, open OpenCode
    local-code wipe   small|mid|big|all   delete a tier to free disk
    local-code sync                       rebuild opencode.json to match what's downloaded
    local-code help                       show this

Notes:
    - OpenCode's model picker shows only downloaded tiers; pull/wipe/sync keep it
      in step (OpenCode can't auto-detect ollama models).
    - Context window defaults to 32k. For more, if you have the RAM:
          LOCAL_CODE_NUM_CTX=65536 local-code pull big
    - Tiers download from Hugging Face and build locally with `ollama create` -
      ollama can't `pull` them directly (it refuses HF's cross-host CDN redirect).
EOF
}

case "${1:-}" in
    list|status) cmd_list ;;
    pull)
        [ -n "${2:-}" ] || { err "usage: local-code pull small|mid|big|all"; exit 2; }
        if [ "$2" = "all" ]; then
            for_each_tier cmd_pull
        else
            tier_quant "$2" >/dev/null || { err "unknown tier: $2"; exit 2; }
            cmd_pull "$2"
        fi
        sync_config
        ;;
    wipe)
        [ -n "${2:-}" ] || { err "usage: local-code wipe small|mid|big|all"; exit 2; }
        if [ "$2" = "all" ]; then
            for_each_tier cmd_wipe
        else
            tier_quant "$2" >/dev/null || { err "unknown tier: $2"; exit 2; }
            cmd_wipe "$2"
        fi
        sync_config
        ;;
    sync) sync_config ;;
    run)
        [ -n "${2:-}" ] || { err "usage: local-code run small|mid|big"; exit 2; }
        tier_quant "$2" >/dev/null || { err "unknown tier: $2"; exit 2; }
        cmd_run "$2"
        ;;
    help|-h|--help|"") usage ;;
    *) err "unknown command: $1"; usage; exit 2 ;;
esac
